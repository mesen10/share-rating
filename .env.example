# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# Create a Trakt API app at https://trakt.tv/oauth/applications
# Redirect URI: urn:ietf:wg:oauth:2.0:oob
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Your IMDb user id (ur...), from your IMDb profile URL.
# Your ratings list must be public.
IMDB_USER_ID=

# Optional: TMDB API key for posters, from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional overrides
# DB_PATH=share_rating.db
# PORT=8765
