# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# Create a Trakt API app at https://trakt.tv/oauth/applications
# Redirect URI: http://localhost:8510/callback
TRAKT_CLIENT_ID=
# Only older Trakt apps have a client secret; new apps show "Not issued". Leave empty then.
TRAKT_CLIENT_SECRET=

# IMDb ratings are not configured here: export them on IMDb
# (Your Ratings -> Export) and upload the CSV on the app's page.

# Optional: TMDB API key for posters, from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional overrides
# DB_PATH=share_rating.db
# PORT=8510
